# Default: public official sources, no paid event/search API calls even if old keys remain.
# Set hybrid explicitly to opt into configured commercial connectors.
CONCERT_PASSPORT_DATA_MODE=official
# Official/live event discovery adapters. Never commit real values.
TICKETMASTER_API_KEY=
PREDICTHQ_ACCESS_TOKEN=
BRAVE_SEARCH_API_KEY=
# Production Compose supplies this private service URL automatically.
SEARXNG_URL=
# Local development defaults, relative to apps/web (where npm scripts run).
# Production app.env must override these with its HTTPS origin and /data paths.
CONCERT_PASSPORT_SITE_URL=http://localhost:3000
CONCERT_PASSPORT_DB_PATH=./data/concert-passport.sqlite
CONCERT_PASSPORT_MEDIA_CACHE_PATH=./data/media-cache
TICKETMASTER_DAILY_REQUEST_BUDGET=4500
TICKETMASTER_MIN_INTERVAL_MS=230
TICKETMASTER_MAX_RETRIES=1
TICKETMASTER_MARKET_SWEEP_PAGES=5
TICKETMASTER_ARTIST_DISCOVERY_PAGES=3
PREDICTHQ_MARKET_SWEEP_SHARDS=16
PREDICTHQ_MAX_PAGES_PER_WINDOW=4
PREDICTHQ_CHANGE_PAGES_PER_RUN=4
INGESTION_ARTIST_TARGETS=16
INGESTION_ARTIST_BATCH_SIZE=4
MEDIA_REFRESH_ARTIST_LIMIT=12
MEDIA_REFRESH_INTERVAL_MS=21600000
ARTIST_CATALOG_INTERVAL_MS=21600000
LINK_RESOLUTION_INTERVAL_MS=1200000
SCHEDULER_TICK_INTERVAL_MS=60000
INGESTION_CRON_SECRET=
INGESTION_INTERVAL_MS=1200000

# Independent official-page frontier; API outages do not disable this job.
OFFICIAL_COLLECTION_INTERVAL_MS=300000
